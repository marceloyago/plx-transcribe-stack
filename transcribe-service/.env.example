PLX_WHISPER_MODEL_SIZE=base
PLX_WHISPER_DEVICE=cpu
PLX_WHISPER_COMPUTE_TYPE=int8
PLX_SKIP_WHISPER_PRELOAD=0
PLX_REQUIRE_HUMAN_APPROVAL=0
PLX_API_PORT=3055
PLX_PUBLIC_BASE_URL=http://127.0.0.1:3055
PLX_SERVICE_ID=plx-transcribe-service
